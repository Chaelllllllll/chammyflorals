{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:admin": "powershell -ExecutionPolicy Bypass -File switch-to-admin.ps1 && expo start",
    "start:customer": "powershell -ExecutionPolicy Bypass -File switch-to-customer.ps1 && expo start",
    "build:admin": "powershell -ExecutionPolicy Bypass -File build-admin.ps1",
    "build:admin:android": "powershell -ExecutionPolicy Bypass -File build-admin.ps1 -Platform android",
    "build:admin:ios": "powershell -ExecutionPolicy Bypass -File build-admin.ps1 -Platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.8.5",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.6.3",
    "@sentry/react-native": "^7.7.0",
    "@supabase/supabase-js": "^2.83.0",
    "expo": "~54.0.25",
    "expo-constants": "~18.0.10",
    "expo-device": "~8.0.9",
    "expo-linear-gradient": "^15.0.7",
    "expo-notifications": "^0.32.13",
    "expo-secure-store": "^15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo-module-scripts": "^5.0.7",
    "typescript": "~5.9.2"
  },
  "private": true
}
